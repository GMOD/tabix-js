{
  "name": "@gmod/tabix",
  "version": "3.13.1",
  "packageManager": "pnpm@11.15.1",
  "description": "Read Tabix-indexed files, supports both .tbi and .csi indexes",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "exports": {
    "import": "./esm/index.js",
    "require": "./dist/index.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMOD/tabix-js.git"
  },
  "author": {
    "name": "Robert Buels",
    "email": "rbuels@gmail.com",
    "url": "https://github.com/rbuels"
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "scripts": {
    "test": "vitest",
    "clean": "rimraf dist esm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "prebuild": "pnpm clean",
    "build:esm": "tsc --outDir esm",
    "build:es5": "tsc --module commonjs --moduleResolution bundler --outDir dist",
    "postbuild:es5": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test --run && pnpm build",
    "postversion": "git push --follow-tags",
    "build": "pnpm build:esm && pnpm build:es5",
    "differential": "node scripts/differential.mjs",
    "benchonly": "vitest bench",
    "bench": "./scripts/build-both-branches.sh \"$BRANCH1\" \"$BRANCH2\" && vitest bench",
    "postbuild": "webpack",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md"
  },
  "keywords": [
    "bionode",
    "biojs",
    "genomics"
  ],
  "dependencies": {
    "@gmod/bgzf-filehandle": "^6.8.0",
    "@gmod/shared-read-cache": "^2.1.0",
    "@jbrowse/quick-lru": "^8.0.0",
    "generic-filehandle2": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "git-cliff": "^2.14.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
